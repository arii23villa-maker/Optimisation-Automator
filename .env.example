# Copy to .env and fill in. Never commit real values.

# LLM providers. The router (src/services/llm.ts) uses Gemini first for writing pages and
# Groq first for the review checks; each is the other's fallback. At least one is required.
GEMINI_API_KEY=""
GROQ_API_KEY=""
# Optional: free Gemini models to chain for writing and fact-checking, best first. Each has its own free
# daily quota on the same key. Leave empty for the default:
#   gemini-2.5-flash,gemini-3.1-flash-lite,gemma-4-31b-it,gemini-3.8-flash
GEMINI_MODELS=""
# Optional: Gemini models the review checks may use when Groq is busy
# (default gemini-3.1-flash-lite,gemma-4-31b-it,gemini-2.5-flash).
GEMINI_CHECK_MODELS=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"
# Groq tokens-per-minute limit used to skip requests that cannot fit (free tier: 8000).
GROQ_TPM_LIMIT="8000"

# Firecrawl (optional): primary scraper for Agent 1. Without it, direct fetch is used.
FIRECRAWL_API_KEY=""

# Google Ads Keyword Planner (optional): verified search volumes.
# All five values are required; without them, keywords show "vol. n/a".
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# Comma-separated origins allowed to call the API cross-origin (same-origin always works).
ALLOWED_ORIGINS=""

# Admin panel at /admin (disabled until set). Use 12+ characters.
ADMIN_PASSWORD=""
# Optional site password: the workspace and API need a sign-in (the landing page stays public).
APP_PASSWORD=""
# Optional signing secret for sessions and run checkpoints (32+ random characters).
# Default: derived from the keys above, so every server instance shares it.
SESSION_SECRET=""
# Who may embed the app in a frame (default: this site and Google AI Studio).
FRAME_ANCESTORS=""
# Set to 1 behind a trusted proxy other than Vercel, so client IPs are read from proxy headers.
TRUST_PROXY=""
# Optional: show rupee estimates next to USD in the admin panel.
USD_INR_RATE=""
# Optional: where usage logs are stored (default data/usage). Use persistent storage in production.
USAGE_LOG_DIR=""

# Vercel only: longest one request may run, in seconds (Hobby 300, Pro up to 800). A pipeline run is
# split into several requests that each stay under it.
FUNCTION_MAX_DURATION=""
# Local testing only: simulate that request limit (e.g. 280) without deploying.
PIPELINE_STEP_SECONDS=""
