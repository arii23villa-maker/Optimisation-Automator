# Copy to .env and fill in. Never commit real values.

# Gemini (required for the maker, the LLM review gates and verification).
GEMINI_API_KEY=""
# Optional model overrides. The fallback is used if the primary errors.
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"

# Firecrawl (optional): primary scraper for Agent 1. Without it, direct fetch is used.
FIRECRAWL_API_KEY=""

# Google Ads Keyword Planner (optional): verified search volumes.
# All five values are required; without them, keywords show "vol. n/a".
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# Comma-separated origins allowed to call the API cross-origin (same-origin always works).
ALLOWED_ORIGINS=""
